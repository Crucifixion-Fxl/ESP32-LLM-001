# ESP32-S3 16MB Flash + 8MB Octal PSRAM (N16R8 模组)
# 首次 idf.py build 时自动生效；如已有 sdkconfig 会覆盖默认值
CONFIG_IDF_TARGET="esp32s3"

# 16MB Flash（分区表顶到 0x1000000）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM（计算缓冲区 / KV Cache / logits 都在 PSRAM）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# 性能
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 使用项目根目录的 partitions.csv（含 model 自定义分区）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILE="partitions.csv"

# 日志与交互走芯片内置 USB-Serial-JTAG（板子 USB-C 直连，无桥接芯片）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 主频拉满时 SPI DMA 与 cache 崩溃的已知坑，关掉安全但慢的选项
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
